DATABASE_URL=sqlite:///./reciluz.db
NODE_RED_COMMAND_URL=http://localhost:1880/comando-lampada

# ─── E-mail (SMTP) ──────────────────────────────────────────────────────────
# Deixe SMTP_HOST vazio para desativar o envio de e-mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
# Gere uma Senha de App em: myaccount.google.com → Segurança → Senhas de app
SMTP_PASSWORD=sua_senha_de_app_gmail
# Remetente exibido no e-mail (opcional; usa SMTP_USER se não definido)
SMTP_FROM=reciluz@gmail.com

# Hora do envio diário do relatório (horário de Recife, 0–23)
RELATORIO_HORA_ENVIO=8
