    {
        "id": "e3ed2f5f175a7473",
        "type": "function",
        "z": "93716f6aaa86542e",
        "name": "Publicar comando MQTT",
        "func": "let comando = msg.payload;\n\nif (typeof comando === \"string\") {\n    comando = JSON.parse(comando);\n}\n\nif (Buffer.isBuffer(comando)) {\n    comando = JSON.parse(comando.toString());\n}\n\nconst lampadaId = comando.lampada_id ?? 1;\n\nmsg.topic = `reciluz/lampada/${lampadaId}/comando`;\n\nif (comando.automatico === true) {\n    msg.payload = \"auto\";\n} else if (comando.ligada !== undefined) {\n    msg.payload = JSON.stringify({\n        lampada_id: lampadaId,\n        ligada: comando.ligada\n    });\n} else {\n    msg.statusCode = 400;\n    msg.payload = { erro: \"Payload inválido\" };\n    return msg;\n}\n\nmsg.statusCode = 200;\nreturn msg;\n",
